import math

#Welcome to the LR program
print(''' Menu:
1. create new set of datapoints
2. remove a set of datapoints
3. Append new values to a set of data points
4. predict
5. exit''')
L={}

def sum_of_deviations_squared(list,A,B):
    sum=0
    for k in list:
      sum += (k[1]-A-B*k[0])**2
      return sum

def sum_of_squares_x(list):
    sq_sum = 0
    for i in list:
      sq_sum += i[0]**2
      return sq_sum

def def sum_of_squares_y(list):
    sq_sum = 0
    for i in list:
      sq_sum += i[1]**2
      return sq_sum

def sum_of_x(list):
    sq_sum = 0
    for i in list:
      sq_sum += i[0]
      return sq_sum

def sum_of_y(list):
    sq_sum = 0
    for i in list:
        sq_sum += i[1]
        return sq_sum

def sum_of_xy(list):
    sq_sum = 0
    for i in list:
        sq_sum += i[0]*i[1]
        return sq_sum

