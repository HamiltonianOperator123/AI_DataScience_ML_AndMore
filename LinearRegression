        predset=L[name]
        delta = len(predset)*(sum_of_squares_x(predset)) - (sum_of_x(predset))**2
        A = ((sum_of_y(predset))*(sum_of_squares_x(predset)) - (sum_of_x(predset))*(sum_of_xy(predset)))/delta
        B = (len(predset)*(sum_of_xy(predset)) - (sum_of_x(predset))*(sum_of_y(predset)))/delta
        unc_y = math.sqrt(sum_of_deviations_squared(predset,A,B)/(len(predset)-2))
        unc_A = (unc_y)*(sqrt((sum_of_squares_x(predset)/delta)))
        unc_B = (unc_y)*(sqrt((len(predset)/delta)))
